---
interface Props {
  items: { role: string; org: string; years: string; links?: { label: string; href: string }[] }[];
}

const { items } = Astro.props;
const linkClass = 'text-text decoration-accent hover:text-accent';
---

<section class="experience" aria-labelledby="experience-heading">
  <h2 id="experience-heading" class="eyebrow">Experience</h2>
  <ol class="mt-3 border-t border-border">
    {
      items.map(({ role, org, years, links = [] }, index) => {
        // A row whose only case is the employer itself links the employer's name.
        const orgIsCase = links.length === 1 && links[0].label === org;
        return (
          <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-b border-border py-2 text-14 leading-[1.4]">
            <span class:list={['font-display font-semibold', { 'text-accent': index === 0 }]}>
              {role}
              <span class="ml-2 font-body font-normal text-text-muted">
                {orgIsCase ? (
                  <a class={linkClass} href={links[0].href}>
                    {org} <span aria-hidden="true">→</span>
                  </a>
                ) : (
                  org
                )}
                {!orgIsCase && links.length > 0 && (
                  <>
                    {': '}
                    {links.map((l, i) => (
                      <>
                        {i > 0 && ' · '}
                        <a class={linkClass} href={l.href}>
                          {l.label}
                        </a>
                      </>
                    ))}
                  </>
                )}
              </span>
            </span>
            <span class="text-text-muted tabular-nums">{years}</span>
          </li>
        );
      })
    }
  </ol>
</section>

---
// Companies Malin has worked with or for (home.md → companies), as a strip that scrolls
// slowly and endlessly sideways. Hovering pauses it. With reduced motion the names simply
// wrap, centred. Logos are white; a company without a logo is shown by name.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  items: { name: string; logo?: ImageMetadata; logoOnly?: boolean; logoHeight?: number }[];
  // The strip is on the page twice (above the case deck and above the case list), but only
  // one is shown at a time, so each needs its own heading id
  id?: string;
  class?: string;
}

const { items, id = 'companies', class: className } = Astro.props;
---

{
  items.length > 0 && (
    <section class:list={['overflow-hidden', className]} aria-labelledby={`${id}-heading`}>
      <h2 id={`${id}-heading`} class="sr-only">
        Companies I've worked with
      </h2>
      {/* Edges fade out, so names glide in and out instead of being cut off */}
      <div class="[mask-image:linear-gradient(to_right,transparent,black_12%,black_88%,transparent)] motion-reduce:[mask-image:none]">
        <div class="flex w-max hover:[animation-play-state:paused] motion-safe:animate-marquee motion-reduce:w-auto motion-reduce:justify-center">
          {/* Four copies, moved left by half (two copies), so even a short list fills wide screens */}
          {[0, 1, 2, 3].map((copy) => (
            <ul
              class:list={[
                'flex shrink-0 items-center gap-16 pr-16 md:gap-24 md:pr-24',
                copy > 0 && 'motion-reduce:hidden',
                'motion-reduce:flex-wrap motion-reduce:justify-center motion-reduce:gap-x-12 motion-reduce:gap-y-6 motion-reduce:px-(--gutter) motion-reduce:pr-(--gutter)',
              ]}
              aria-hidden={copy > 0 ? 'true' : undefined}
            >
              {items.map((company) => (
                <li class="flex items-center gap-3 whitespace-nowrap opacity-75">
                  {company.logo && (
                    // Wordmarks 22px tall, marks next to a name 28px, unless the company sets its own
                    <Image
                      src={company.logo}
                      alt={company.logoOnly ? company.name : ''}
                      height={company.logoHeight ?? (company.logoOnly ? 22 : 28)}
                      width={Math.round((company.logo.width * (company.logoHeight ?? (company.logoOnly ? 22 : 28))) / company.logo.height)}
                      layout="fixed"
                      class="h-auto! max-w-none!"
                    />
                  )}
                  {!(company.logo && company.logoOnly) && <span class="font-display text-18 font-heading text-text">{company.name}</span>}
                </li>
              ))}
            </ul>
          ))}
        </div>
      </div>
    </section>
  )
}

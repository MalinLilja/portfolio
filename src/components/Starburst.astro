---
// Olive starburst badge from the colour scheme. Decorative.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;

// 12 soft points
const points = 12;
const d =
  Array.from({ length: points * 2 }, (_, i) => {
    const r = i % 2 === 0 ? 50 : 34;
    const a = (Math.PI * i) / points - Math.PI / 2;
    return `${(50 + r * Math.cos(a)).toFixed(1)},${(50 + r * Math.sin(a)).toFixed(1)}`;
  }).join(' ');
---

<svg class:list={['text-olive', className]} viewBox="0 0 100 100" aria-hidden="true">
  <polygon points={d} fill="currentColor" stroke="currentColor" stroke-width="6" stroke-linejoin="round"></polygon>
</svg>

---
// Malin's cut-out photo, placed over the lower right of the hero and overlapping its
// bottom edge. It stays put while the hero is pinned, and the growing star covers it as the
// hero turns dark (see HeroStarWipe). The bottom third fades out so the cut-out
// has no hard edge. Moving the mouse over the photo gives it a small nudge in the direction
// of the movement, and it springs back (mouse only, and not with reduced motion). Must sit
// inside a `relative` wrapper around the hero.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
}

const { src, alt } = Astro.props;
---

<div
  class="hero-photo pointer-events-none absolute [mask-image:linear-gradient(to_bottom,black_62%,transparent)] right-0 -bottom-16 z-10 w-[84vw] max-w-[820px] md:right-[calc(var(--gutter)+1%)] md:-bottom-24 md:w-[50vw] lg:right-[calc(max(0px,(100vw-var(--container-content))/2-360px)-4vw)] lg:w-[58vw] lg:max-w-[976px]"
>
  <Image
    src={src}
    alt={alt}
    widths={[320, 480, 720, 976]}
    sizes="(min-width: 1683px) 976px, (min-width: 1080px) 58vw, (min-width: 720px) 50vw, 84vw"
    loading="eager"
    class="hero-photo-img h-auto! w-full!"
  />
</div>

<script>
  const photo = document.querySelector<HTMLElement>('.hero-photo');
  const img = photo?.querySelector<HTMLElement>('.hero-photo-img');
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
  if (photo && img) {
    // A spring: mouse movement pushes the photo, and it eases back to where it was
    // The whole frame moves (not the picture inside it): the frame's fade mask also clips to
    // its edges, so moving the picture inside it would cut off its sides
    const PUSH = 0.1; // share of the mouse movement passed on to the photo
    const MAX_PX = 4;
    const STIFFNESS = 0.08;
    const DAMPING = 0.82;
    let x = 0;
    let y = 0;
    let vx = 0;
    let vy = 0;
    let frame = 0;

    const tick = () => {
      vx = (vx - x * STIFFNESS) * DAMPING;
      vy = (vy - y * STIFFNESS) * DAMPING;
      x = Math.max(-MAX_PX, Math.min(MAX_PX, x + vx));
      y = Math.max(-MAX_PX, Math.min(MAX_PX, y + vy));
      photo.style.transform = `translate3d(${x.toFixed(2)}px, ${y.toFixed(2)}px, 0) rotate(${(x * 0.03).toFixed(3)}deg)`;
      const resting = Math.abs(x) < 0.05 && Math.abs(y) < 0.05 && Math.abs(vx) < 0.05 && Math.abs(vy) < 0.05;
      if (resting) {
        photo.style.transform = '';
        frame = 0;
      } else {
        frame = requestAnimationFrame(tick);
      }
    };

    document.addEventListener(
      'pointermove',
      (event) => {
        // Not once the star has covered the photo
        if (event.pointerType !== 'mouse' || reduceMotion.matches || photo.style.opacity === '0') return;
        // The cut-out doesn't fill its box at the sides, so the area that reacts is a bit narrower
        const r = photo.getBoundingClientRect();
        const inside =
          event.clientX > r.left + r.width * 0.15 &&
          event.clientX < r.right - r.width * 0.15 &&
          event.clientY > r.top &&
          event.clientY < r.bottom - r.height * 0.15;
        if (!inside) return;
        // Fast flicks count no more than a medium movement, so the nudge stays small
        const cap = (n: number) => Math.max(-24, Math.min(24, n));
        vx = Math.max(-2, Math.min(2, vx + cap(event.movementX) * PUSH * STIFFNESS * 4));
        vy = Math.max(-2, Math.min(2, vy + cap(event.movementY) * PUSH * STIFFNESS * 4));
        if (!frame) frame = requestAnimationFrame(tick);
      },
      { passive: true },
    );
  }
</script>

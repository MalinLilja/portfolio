---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  client: string;
  summary: string;
  tags?: string[];
  /** Leave out for a "Coming soon" card that doesn't link anywhere */
  href?: string;
  image?: ImageMetadata;
  note?: string;
  /** Case accent from tokens.css, used for the thumbnail frame */
  accent?: string;
}

const { client, summary, tags = [], href, image, note, accent } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<article class="text-text">
  <Tag
    href={href}
    class:list={[
      'group grid grid-cols-[64px_minmax(0,1fr)] items-center gap-4 rounded-card p-3 no-underline',
      'border sm:grid-cols-[64px_minmax(0,1fr)_auto] md:grid-cols-[80px_minmax(0,1fr)_auto]',
      href
        ? 'border-border bg-surface-raised transition-[border-color,translate,box-shadow] duration-160 ease-out hover:-translate-y-0.5 hover:border-ink hover:shadow-[4px_4px_0_var(--color-violet)]'
        : 'border-dashed border-stars',
    ]}
  >
    <!-- data-case gives the thumbnail frame the case's own background -->
    <div
      data-case={accent}
      class:list={['grid aspect-4/3 w-16 place-items-center overflow-hidden rounded-thumb md:w-20', image ? 'bg-bg' : 'bg-ink']}
    >
      {
        image ? (
          <Image
            src={image}
            alt=""
            width={160}
            height={120}
            layout="fixed"
            fit="cover"
            position="left top"
            class="size-full object-cover object-left-top"
          />
        ) : (
          <span class="font-display text-14 font-bold text-on-ink" aria-hidden="true">
            {client.split(' ')[0]}
          </span>
        )
      }
    </div>
    <div>
      <h3 class="flex flex-wrap items-baseline gap-x-2 gap-y-1 text-17 font-bold">
        {client}
        {note && <span class="font-body text-14 font-medium text-text-muted">{note}</span>}
      </h3>
      <p class="mt-1 text-14 leading-[1.45]">{summary}</p>
      {tags.length > 0 && <p class="mt-1 text-13 text-text-muted">{tags.join(' · ')}</p>}
    </div>
    {
      href && (
        <span
          class="hidden pr-2 text-22 transition-transform duration-160 ease-out group-hover:translate-x-1 sm:block"
          aria-hidden="true"
        >
          →
        </span>
      )
    }
  </Tag>
</article>

---
// Selected work as clear, focused cards, one per case, stacked (see CaseCard). This is the
// version for phones, tablets, reduced motion and no JavaScript; on wide screens with
// motion the cases are shown as the card deck on the dark hero instead (CaseDeck).
import CaseCard, { type CaseItem } from './CaseCard.astro';

interface Props {
  items: CaseItem[];
}

const { items } = Astro.props;
---

<ol class="grid gap-6 md:gap-8">
  {
    items.map((item, i) => (
      <li>
        <CaseCard item={item} eager={i === 0} />
      </li>
    ))
  }
</ol>

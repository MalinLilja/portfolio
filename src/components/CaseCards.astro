---
// Selected work as a grid of case cards (see CaseCard): one column on phones, two from
// tablets up. Each card has a fixed height, so the pictures over the liquid background get
// the same room in every card, and the rows line up.
import CaseCard, { type CaseItem } from './CaseCard.astro';

interface Props {
  items: CaseItem[];
}

const { items } = Astro.props;
---

<ol class="grid gap-8 md:grid-cols-2">
  {
    // No eager pictures: the grid starts below the first screen
    items.map((item) => (
      <li class="h-[34rem]">
        <CaseCard item={item} compact />
      </li>
    ))
  }
</ol>

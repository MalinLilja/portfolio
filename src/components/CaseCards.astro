---
// Selected work as clear, focused cards, one per case, stacked (see CaseCard). This is the
// version for phones, tablets, reduced motion and no JavaScript; on wide screens with
// motion the cases are shown as the card deck on the dark hero instead (CaseDeck).
import CaseCard, { type CaseItem } from './CaseCard.astro';

interface Props {
  items: CaseItem[];
}

const { items } = Astro.props;
---

<ol class="grid gap-16 md:gap-20">
  {
    // No eager pictures: on wide screens this list is hidden (the deck shows instead), and eager
    // pictures would still download there; on phones the list starts below the first screen
    items.map((item) => (
      <li>
        <CaseCard item={item} />
      </li>
    ))
  }
</ol>

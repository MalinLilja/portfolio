---
// Case study summary as a bento grid, laid out like a case study template:
//   the brief (no heading)                 | picture   (the picture spans two rows on wide screens)
//   time and role | team                   | picture
//   problem                                | design intent
//   outcome
// (The insight is shown at the end of the case page instead.)
//   company (hidden for now: showCompany)
// The brief falls back to the purpose, and the design intent to "What I did". Tiles whose text
// is still a [gap] are left out, and the grid closes up around them.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BentoTile from './BentoTile.astro';
import RoleBadges from './RoleBadges.astro';
import { hideGaps } from '../lib/brackets';

interface Props {
  hero: ImageMetadata;
  heroAlt: string;
  roles: string[];
  purpose?: string;
  tldr: {
    company: string;
    timeline?: string;
    team?: string;
    stakeholders?: string[];
    brief?: string;
    problem: string;
    designIntent?: string;
    whatIDid: string;
    result?: string;
  };
}

const { hero, heroAlt, roles, tldr } = Astro.props;
const brief = hideGaps(tldr.brief) || hideGaps(Astro.props.purpose);
const timeline = hideGaps(tldr.timeline);
const problem = hideGaps(tldr.problem);
const designIntent = hideGaps(tldr.designIntent) || hideGaps(tldr.whatIDid);
const result = hideGaps(tldr.result);
const team = hideGaps(tldr.team);
// "Optimum Earnings, freight and shipping industry" → name + description
const [companyName, ...rest] = hideGaps(tldr.company).split(', ');
const companyAbout = rest.join(', ');
const showCompany = false;
// Never upscale: only widths up to the source image's own width
const widths = [...[480, 720, 1080, 1440].filter((w) => w < hero.width), hero.width];
// The same body text as the company description, a size up for the longer paragraphs
const text = 'text-16 leading-body text-text-muted';
---

<section class="grid grid-flow-row-dense grid-cols-1 gap-3 md:grid-cols-2 md:gap-4 lg:grid-cols-4" aria-label="Project summary">
  {
    brief && (
      <BentoTile class="md:col-span-2 lg:col-start-1 lg:row-start-1">
        <p class="font-headline text-22 leading-snug font-medium text-balance">{brief}</p>
      </BentoTile>
    )
  }

  <BentoTile label={timeline ? 'Time and role' : 'My role'} class:list={['lg:col-start-1', brief ? 'lg:row-start-2' : 'lg:row-start-1', !team && 'md:col-span-2']}>
    {timeline && <p class="font-display text-17 font-heading tabular-nums">{timeline}</p>}
    <RoleBadges roles={roles} />
  </BentoTile>

  {
    team && (
      <BentoTile label="Team" class:list={['lg:col-start-2', brief ? 'lg:row-start-2' : 'lg:row-start-1']}>
        <p>{team}</p>
      </BentoTile>
    )
  }

  <div class="overflow-hidden rounded-media border border-border bg-surface md:col-span-2 lg:col-start-3 lg:row-span-2 lg:row-start-1">
    <Image
      src={hero}
      alt={heroAlt}
      widths={widths}
      sizes="(min-width: 1248px) 600px, (min-width: 720px) calc(100vw - 2 * var(--gutter)), 100vw"
      loading="eager"
      fetchpriority="high"
      class="h-full! w-full! max-w-none! max-h-none cursor-zoom-in object-cover object-left-top"
      data-zoomable
    />
  </div>

  <BentoTile label="Problem" class="md:col-span-2">
    <p class={text}>{problem}</p>
  </BentoTile>

  <BentoTile label="Design intent" class="md:col-span-2">
    <p class={text}>{designIntent}</p>
  </BentoTile>

  {
    result && (
      <BentoTile label="Outcome" class="md:col-span-2 lg:col-span-4">
        <p class={text}>{result}</p>
      </BentoTile>
    )
  }

  {/* The company box is hidden for now; set to true to show it again */}
  {showCompany && (
  <BentoTile label="Company" class="md:col-span-2 lg:col-span-4">
    <p class="font-display text-17 font-heading">{companyName}</p>
    {companyAbout && <p class="text-14 text-text-muted">{companyAbout}</p>}
  </BentoTile>
  )}

</section>

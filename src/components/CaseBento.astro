---
// Case study summary as a bento grid: the main picture as the biggest tile, then purpose,
// company, role, timeline, stakeholders, team, what I did and result. Replaces the old TL;DR box.
// Tiles whose text is still a [gap] are left out, and the grid closes up around them.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BentoTile from './BentoTile.astro';
import RoleBadges from './RoleBadges.astro';
import { hideGaps, hideGapItems } from '../lib/brackets';

interface Props {
  hero: ImageMetadata;
  heroAlt: string;
  roles: string[];
  purpose?: string;
  tldr: {
    company: string;
    timeline?: string;
    team?: string;
    stakeholders?: string[];
    whatIDid: string;
    result?: string;
  };
}

const { hero, heroAlt, roles, tldr } = Astro.props;
const purpose = hideGaps(Astro.props.purpose);
const timeline = hideGaps(tldr.timeline);
const team = hideGaps(tldr.team);
const stakeholders = hideGapItems(tldr.stakeholders);
const whatIDid = hideGaps(tldr.whatIDid);
const result = hideGaps(tldr.result);
// "Optimum Earnings, freight and shipping industry" → name + description
const [companyName, ...rest] = hideGaps(tldr.company).split(', ');
const companyAbout = rest.join(', ');
// Never upscale: only widths up to the source image's own width
const widths = [...[480, 720, 1080, 1440].filter((w) => w < hero.width), hero.width];
---

<section class="grid grid-flow-row-dense grid-cols-1 gap-3 md:grid-cols-2 md:gap-4 lg:grid-cols-4" aria-label="Project summary">
  <div class="overflow-hidden rounded-media border border-border bg-surface md:col-span-2 lg:row-span-3">
    <Image
      src={hero}
      alt={heroAlt}
      widths={widths}
      sizes="(min-width: 1248px) 600px, (min-width: 720px) calc(100vw - 2 * var(--gutter)), 100vw"
      loading="eager"
      fetchpriority="high"
      class="h-full! w-full! max-w-none! max-h-none cursor-zoom-in object-cover object-left-top"
      data-zoomable
    />
  </div>

  {
    purpose && (
      <BentoTile label="Purpose" class="md:col-span-2">
        <p class="font-headline text-22 leading-snug font-medium text-balance">{purpose}</p>
      </BentoTile>
    )
  }

  <BentoTile label="Company" class:list={[!timeline && 'lg:col-span-2']}>
    <p class="font-display text-17 font-heading">{companyName}</p>
    {companyAbout && <p class="text-14 text-text-muted">{companyAbout}</p>}
  </BentoTile>

  {
    timeline && (
      <BentoTile label="Timeline">
        <p class="font-display text-17 font-heading tabular-nums">{timeline}</p>
      </BentoTile>
    )
  }

  <BentoTile label="My role" class="md:col-span-2">
    <RoleBadges roles={roles} />
  </BentoTile>

  <BentoTile label="What I did" class:list={['md:col-span-2', !team && stakeholders.length === 0 && 'lg:col-span-4']}>
    <p>{whatIDid}</p>
  </BentoTile>

  {
    stakeholders.length > 0 && (
      <BentoTile label="Stakeholders" class="md:col-span-2">
        <ul class="flex flex-wrap gap-2">
          {stakeholders.map((s) => (
            <li class="rounded-pill border border-border px-3 py-1 text-13 text-text">{s}</li>
          ))}
        </ul>
      </BentoTile>
    )
  }

  {
    team && (
      <BentoTile label="Team" class:list={['md:col-span-2', stakeholders.length > 0 && 'lg:col-span-4']}>
        <p>{team}</p>
      </BentoTile>
    )
  }

  {
    result && (
      <BentoTile label="Result" class="md:col-span-2 lg:col-span-4">
        <p class="font-headline text-18 leading-snug font-medium">{result}</p>
      </BentoTile>
    )
  }
</section>

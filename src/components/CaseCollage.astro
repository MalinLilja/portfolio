---
// The picture area of a case card: the liquid gradient (a still of the hero background) with
// up to three of the case's pictures laid over it, a little tilted and overlapping. Slots
// without a picture are empty frames. When the card is hovered (or focused) the pictures grow
// a little. Must sit inside an element with `group`.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import gradient from '../assets/site/gradient.jpg';

interface Props {
  images: ImageMetadata[];
  // Alt text for the first picture; the others are decorative
  alt?: string;
  eager?: boolean;
  // Leave out the gradient, when the card already has it behind everything (CaseCard)
  bare?: boolean;
  // Let the pictures stick out above the area's top edge (never down over the card's text).
  // "stacked" only does this while the text is under the pictures (below lg), not when it
  // sits beside them.
  spill?: 'always' | 'stacked';
}

const { images, alt = '', eager = false, bare = false, spill } = Astro.props;

// Left, right and a smaller one in front in the middle. Each is 16:10, as wide as the area's
// width or height allows (cqw/cqh: the area is a size container), so they keep their shape on
// wide, short cards and on narrow phone cards alike. Rotation and
// hover growth are separate properties (rotate, scale), so they combine. The small one always
// stays inside, so it never covers the card's title.
const contained = [
  'left-[4%] top-[9%] w-[min(58cqw,112cqh)]',
  'right-[4%] top-[16%] w-[min(60cqw,118cqh)]',
  'left-[33%] bottom-[5%] w-[min(40cqw,74cqh)]',
];
const spilling = [
  'left-[3%] -top-[12%] w-[min(58cqw,134cqh)]',
  'right-[3%] -top-[5%] w-[min(62cqw,144cqh)]',
  'left-[31%] bottom-[6%] w-[min(38cqw,70cqh)]',
];
const spillingBelowLg = [
  'left-[3%] -top-[12%] w-[min(58cqw,134cqh)] lg:top-[9%] lg:w-[min(58cqw,112cqh)]',
  'right-[3%] -top-[5%] w-[min(62cqw,144cqh)] lg:top-[16%] lg:w-[min(60cqw,118cqh)]',
  'left-[31%] bottom-[6%] w-[min(38cqw,70cqh)] lg:bottom-[5%] lg:w-[min(40cqw,74cqh)]',
];
const place = spill === 'always' ? spilling : spill === 'stacked' ? spillingBelowLg : contained;
const tilt = ['-rotate-[5deg] z-10', 'rotate-[2deg] z-20', '-rotate-[1.5deg] z-30'];
const slots = place.map((p, i) => `${p} ${tilt[i]}`);
---

<div class:list={['relative size-full [container-type:size]', !spill && 'overflow-hidden', !bare && 'bg-liquid-mid']}>
  {!bare && <Image src={gradient} alt="" widths={[640, 1080, 1600]} sizes="(min-width: 1080px) 1100px, 100vw" loading={eager ? 'eager' : 'lazy'} class="absolute inset-0 size-full! max-w-none! object-cover" />}
  {
    slots.map((slot, i) => {
      const image = images[i];
      return (
        <div
          class:list={[
            'pointer-events-none absolute aspect-16/10 overflow-hidden rounded-[10px] shadow-[0_18px_40px_-12px_color-mix(in_oklab,var(--color-bg)_70%,transparent)] transition-[scale] duration-500 ease-out group-hover:scale-[1.04] group-focus-within:scale-[1.04] motion-reduce:transition-none',
            slot,
            image ? 'bg-bg' : 'border-2 border-dashed border-on-liquid-muted/50 bg-surface/15 shadow-none',
          ]}
          style={`transition-delay: ${i * 40}ms`}
        >
          {image && (
            <Image
              src={image}
              alt={i === 0 ? alt : ''}
              widths={[480, 720, 1080]}
              sizes="(min-width: 1080px) 600px, 60vw"
              loading={eager && i === 0 ? 'eager' : 'lazy'}
              class="size-full! max-w-none! object-cover object-left-top"
            />
          )}
        </div>
      );
    })
  }
</div>

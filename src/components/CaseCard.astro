---
// One case as a card: the case picture, then company and timeline, the case title, its
// purpose, and three short parts (challenge, what I did, result) from the case's summary,
// with role badges and a link to the case. The whole card is clickable (the title link
// stretches over it). Parts that are still [gaps] are left out.
// `compact` is the version in the card deck on the dark hero: a fixed-height card with
// smaller type, where the text fades out at the bottom instead of growing the card.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import RoleBadges from './RoleBadges.astro';
import { hideGaps } from '../lib/brackets';

export interface CaseItem {
  client: string;
  title?: string;
  purpose?: string;
  timeline?: string;
  problem?: string;
  whatIDid?: string;
  result?: string;
  roles: string[];
  href?: string;
  note?: string;
  accent?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  logo?: ImageMetadata;
}

interface Props {
  item: CaseItem;
  eager?: boolean;
  compact?: boolean;
}

const { item, eager = false, compact = false } = Astro.props;
const parts = [
  { label: 'Challenge', text: hideGaps(item.problem) },
  { label: 'What I did', text: hideGaps(item.whatIDid) },
  { label: 'Result', text: hideGaps(item.result) },
].filter((part) => part.text);
const timeline = hideGaps(item.timeline);
const purpose = hideGaps(item.purpose);
---

<article
  data-case={item.accent}
  class:list={[
    'group relative grid overflow-hidden rounded-media border bg-surface',
    compact ? 'h-full grid-cols-[minmax(0,58fr)_minmax(0,42fr)]' : 'lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)]',
    item.href
      ? // On hover (and keyboard focus) the border takes the case colour and the card glows in it
        'border-border transition-[border-color,box-shadow] duration-300 ease-out hover:border-case-accent hover:shadow-[0_0_56px_-10px_color-mix(in_oklab,var(--color-case-accent-strong)_70%,transparent)] focus-within:border-case-accent focus-within:shadow-[0_0_56px_-10px_color-mix(in_oklab,var(--color-case-accent-strong)_70%,transparent)]'
      : 'border-dashed border-stars',
  ]}
>
  <div class:list={['overflow-hidden bg-bg', compact ? 'border-r border-border' : 'aspect-16/10 border-b border-border lg:aspect-auto lg:min-h-[28rem] lg:border-r lg:border-b-0']}>
    {
      item.image ? (
        <Image
          src={item.image}
          alt={item.imageAlt ?? ''}
          widths={[480, 720, 1080, 1440]}
          sizes={compact ? '(min-width: 1080px) 640px, 100vw' : '(min-width: 1248px) 700px, (min-width: 1080px) 58vw, 100vw'}
          loading={eager ? 'eager' : 'lazy'}
          class="h-full! w-full! max-w-none! object-cover object-left-top transition-transform duration-600 ease-out group-hover:scale-[1.02]"
        />
      ) : (
        <div class="grid size-full place-items-center bg-[linear-gradient(140deg,var(--color-liquid-deep),var(--color-liquid-light)_55%,var(--color-liquid-mid))]">
          <span class="eyebrow text-on-liquid">{item.note}</span>
        </div>
      )
    }
  </div>

  {/* Not positioned, so the title link's click area stretches over the whole card, picture included */}
  <div class:list={['flex min-h-0 flex-col', compact ? 'gap-4 overflow-hidden p-6' : 'gap-5 p-6 md:p-8']}>
    <p class="flex items-center gap-3 text-14 text-text-muted">
      {item.logo && <Image src={item.logo} alt="" widths={[48, 96]} sizes="24px" class="size-6! rounded-pill bg-text object-cover" />}
      <span class="font-display font-heading text-text">{item.client}</span>
      {timeline && <span aria-hidden="true">·</span>}
      {timeline && <span class="tabular-nums">{timeline}</span>}
    </p>

    <div>
      <h3 class:list={['leading-tight text-balance', compact ? 'text-22' : 'text-32']}>
        {
          item.href ? (
            <a href={item.href} class="no-underline transition-colors duration-160 ease-out group-hover:text-case-accent-strong after:absolute after:inset-0 after:content-['']">
              {item.title ?? item.client}
            </a>
          ) : (
            (item.title ?? item.client)
          )
        }
      </h3>
      {purpose && <p class:list={['mt-3 font-headline leading-snug font-medium text-text-muted text-balance', compact ? 'text-16' : 'text-18']}>{purpose}</p>}
    </div>

    {
      parts.length > 0 && (
        <dl class:list={['grid border-t border-border', compact ? 'gap-3 pt-4' : 'gap-4 pt-5']}>
          {parts.map((part) => (
            <div class:list={['grid gap-1', compact ? 'grid-cols-[6.5rem_1fr] gap-3' : 'sm:grid-cols-[8rem_1fr] sm:gap-4']}>
              <dt class="eyebrow text-14">{part.label}</dt>
              <dd class:list={['leading-snug', compact ? 'text-14' : 'text-16']}>{part.text}</dd>
            </div>
          ))}
        </dl>
      )
    }

    <div class:list={['flex flex-wrap items-center justify-between gap-4', compact ? 'hidden' : 'mt-auto pt-2']}>
      <RoleBadges roles={item.roles} />
      {
        item.href && (
          <span class="inline-flex items-center gap-2 text-14 font-medium text-case-accent-strong" aria-hidden="true">
            Read the case
            <span class="transition-transform duration-160 ease-out group-hover:translate-x-1">→</span>
          </span>
        )
      }
    </div>

    {/* In the deck the card has a fixed height: the text fades out at the bottom, with a
        clear button on top so the card reads as clickable */}
    {compact && <span class="pointer-events-none absolute right-0 bottom-0 h-28 w-[42%] bg-linear-to-t from-surface from-40% to-transparent" aria-hidden="true" />}
    {
      compact && item.href && (
        <span
          class="pointer-events-none absolute right-6 bottom-6 inline-flex items-center gap-2 rounded-pill bg-case-accent-strong px-4 py-2 text-14 font-medium text-on-accent transition-transform duration-160 ease-out group-hover:-translate-y-0.5"
          aria-hidden="true"
        >
          Read the case
          <span class="transition-transform duration-160 ease-out group-hover:translate-x-1">→</span>
        </span>
      )
    }
  </div>
</article>

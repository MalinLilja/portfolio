---
// One case as a card: the case pictures over the liquid background (CaseCollage), then company and timeline, the case title, its
// purpose, with role badges and a "Read the case" link. The whole card is clickable (that link
// stretches over the text panel, and the pictures have their own). Parts that are still [gaps]
// are left out.
// `compact` is the version in the card deck on the dark hero: a fixed-height card with just
// the picture, and under it the logo, company, time, case title and "Read the case".
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import RoleBadges from './RoleBadges.astro';
import CaseCollage from './CaseCollage.astro';
import gradient from '../assets/site/gradient.jpg';
import { hideGaps } from '../lib/brackets';

export interface CaseItem {
  client: string;
  title?: string;
  purpose?: string;
  timeline?: string;
  roles: string[];
  href?: string;
  note?: string;
  accent?: string;
  image?: ImageMetadata;
  // Pictures for the collage over the liquid background (CaseCollage)
  images?: ImageMetadata[];
  // The liquid background behind the card (defaults to the shared gradient)
  background?: ImageMetadata;
  imageAlt?: string;
  logo?: ImageMetadata;
}

interface Props {
  item: CaseItem;
  eager?: boolean;
  compact?: boolean;
}

const { item, eager = false, compact = false } = Astro.props;
const timeline = hideGaps(item.timeline);
const purpose = hideGaps(item.purpose);
// On hover (and keyboard focus) the border takes the case colour and the card glows in it
// The text part is frosted glass over the liquid background, which runs under the whole card
const glass = 'relative border-border bg-surface/80 backdrop-blur-xl';
const glow =
  'border-border transition-[border-color] duration-300 ease-out hover:border-case-accent focus-within:border-case-accent';
// Behind the card: its own liquid background, blurred and drifting slowly, so the glow is
// wispy like the hero. It fades in on hover and keyboard focus.
const wisp =
  'pointer-events-none absolute -inset-16 -z-10 overflow-hidden rounded-[64px] opacity-0 blur-[32px] saturate-150 transition-opacity duration-500 ease-out [mask-image:radial-gradient(farthest-side,black_80%,transparent)] group-hover:opacity-100 group-focus-within:opacity-100';
---

{
  compact ? (
    // The deck version: just the picture, with the company, time, case title and the link under it
    <article
      data-case={item.accent}
      class:list={['group relative isolate flex h-full flex-col rounded-media border', item.href ? glow : 'border-dashed border-stars']}
    >
      {item.href && (
        <div class={wisp} aria-hidden="true">
          <Image src={item.background ?? gradient} alt="" widths={[640]} sizes="640px" loading="lazy" class="size-full! max-w-none! object-cover group-hover:motion-safe:animate-wisp" />
        </div>
      )}
      {/* Only the background is clipped to the card, so the pictures can stick out of it */}
      <div class="absolute inset-0 overflow-hidden rounded-media bg-liquid-mid">
        <Image src={item.background ?? gradient} alt="" widths={[640, 1080, 1600]} sizes="(min-width: 1080px) 1100px, 100vw" loading={eager ? 'eager' : 'lazy'} class="absolute inset-0 size-full! max-w-none! object-cover" />
      </div>
      <div class="relative z-10 min-h-0 flex-1">
        {item.images ? (
          <CaseCollage images={item.images} alt={item.imageAlt} eager={eager} bare spill="always" />
        ) : (
          <div class="grid size-full place-items-center bg-[linear-gradient(140deg,var(--color-liquid-deep),var(--color-liquid-light)_55%,var(--color-liquid-mid))]">
            <span class="eyebrow text-on-liquid">{item.note}</span>
          </div>
        )}
        {/* The glass text area keeps the case link's click area to itself, so the pictures get
            their own link ("Read the case" is the one for keyboards and screen readers) */}
        {item.href && <a href={item.href} class="absolute inset-0 z-40" tabindex="-1" aria-hidden="true" />}
      </div>
      <div class:list={['flex items-end justify-between gap-6 rounded-b-media border-t p-6', glass]}>
        <div class="grid min-w-0 gap-2">
          <p class="flex items-center gap-3 text-14 text-text-muted">
            {item.logo && <Image src={item.logo} alt="" widths={[48, 96]} sizes="24px" class="size-6! rounded-pill bg-text object-cover" />}
            <span class="font-display font-heading text-text">{item.client}</span>
            {timeline && <span aria-hidden="true">·</span>}
            {timeline && <span class="tabular-nums">{timeline}</span>}
          </p>
          <h3 class="text-32 leading-tight text-balance">
            <span class="transition-colors duration-160 ease-out group-hover:text-case-accent-strong">{item.title ?? item.client}</span>
          </h3>
        </div>
        {item.href && (
          // The case link: its click area stretches over the whole text panel (the glass is positioned)
          <a
            href={item.href}
            aria-label={`Read the case: ${item.title ?? item.client}`}
            class="inline-flex shrink-0 items-center gap-2 rounded-pill bg-case-accent-strong px-4 py-2 text-14 font-medium text-on-accent no-underline after:absolute after:inset-0 after:content-['']"
          >
            Read the case
            <span class="transition-transform duration-160 ease-out group-hover:translate-x-1" aria-hidden="true">→</span>
          </a>
        )}
      </div>
    </article>
  ) : (
    // The full version (phones, tablets, reduced motion): picture, then the case summary
    <article
      data-case={item.accent}
      class:list={['group relative isolate grid rounded-media border lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)]', item.href ? glow : 'border-dashed border-stars']}
    >
      {item.href && (
        <div class={wisp} aria-hidden="true">
          <Image src={item.background ?? gradient} alt="" widths={[640]} sizes="640px" loading="lazy" class="size-full! max-w-none! object-cover group-hover:motion-safe:animate-wisp" />
        </div>
      )}
      {/* Only the background is clipped to the card, so the pictures can stick out of it */}
      <div class="absolute inset-0 overflow-hidden rounded-media bg-liquid-mid">
        <Image src={item.background ?? gradient} alt="" widths={[640, 1080, 1600]} sizes="(min-width: 1080px) 1200px, 100vw" loading={eager ? 'eager' : 'lazy'} class="absolute inset-0 size-full! max-w-none! object-cover" />
      </div>
      <div class="relative z-10 aspect-16/10 lg:aspect-auto lg:min-h-[28rem]">
        {item.images ? (
          <CaseCollage images={item.images} alt={item.imageAlt} eager={eager} bare spill="stacked" />
        ) : (
          <div class="grid size-full place-items-center bg-[linear-gradient(140deg,var(--color-liquid-deep),var(--color-liquid-light)_55%,var(--color-liquid-mid))]">
            <span class="eyebrow text-on-liquid">{item.note}</span>
          </div>
        )}
        {/* The glass text area keeps the case link's click area to itself, so the pictures get
            their own link ("Read the case" is the one for keyboards and screen readers) */}
        {item.href && <a href={item.href} class="absolute inset-0 z-40" tabindex="-1" aria-hidden="true" />}
      </div>

      <div class:list={['flex min-h-0 flex-col gap-5 rounded-b-media border-t p-6 md:p-8 lg:rounded-none lg:rounded-r-media lg:border-t-0 lg:border-l', glass]}>
        <p class="flex items-center gap-3 text-14 text-text-muted">
          {item.logo && <Image src={item.logo} alt="" widths={[48, 96]} sizes="24px" class="size-6! rounded-pill bg-text object-cover" />}
          <span class="font-display font-heading text-text">{item.client}</span>
          {timeline && <span aria-hidden="true">·</span>}
          {timeline && <span class="tabular-nums">{timeline}</span>}
        </p>

        <div>
          <h3 class="text-32 leading-tight text-balance">
            <span class="transition-colors duration-160 ease-out group-hover:text-case-accent-strong">{item.title ?? item.client}</span>
          </h3>
          {purpose && <p class="mt-3 font-headline text-18 leading-snug font-medium text-text-muted text-balance">{purpose}</p>}
        </div>


        <div class="mt-auto flex flex-wrap items-center justify-between gap-4 pt-2">
          <RoleBadges roles={item.roles} />
          {item.href && (
            // The case link: its click area stretches over the whole text panel (the glass is positioned)
            <a
              href={item.href}
              aria-label={`Read the case: ${item.title ?? item.client}`}
              class="inline-flex items-center gap-2 text-14 font-medium text-case-accent-strong no-underline after:absolute after:inset-0 after:content-['']"
            >
              Read the case
              <span class="transition-transform duration-160 ease-out group-hover:translate-x-1" aria-hidden="true">→</span>
            </a>
          )}
        </div>
      </div>
    </article>
  )
}

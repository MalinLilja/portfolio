---
// One case as a card: the case pictures over the liquid background (CaseCollage), then company and timeline, the case title, its
// purpose, and three short parts (challenge, what I did, result) from the case's summary,
// with role badges and a link to the case. The whole card is clickable (the title link
// stretches over it). Parts that are still [gaps] are left out.
// `compact` is the version in the card deck on the dark hero: a fixed-height card with just
// the picture, and under it the logo, company, time, case title and "Read the case".
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import RoleBadges from './RoleBadges.astro';
import CaseCollage from './CaseCollage.astro';
import gradient from '../assets/site/gradient.jpg';
import { hideGaps } from '../lib/brackets';

export interface CaseItem {
  client: string;
  title?: string;
  purpose?: string;
  timeline?: string;
  problem?: string;
  whatIDid?: string;
  result?: string;
  roles: string[];
  href?: string;
  note?: string;
  accent?: string;
  image?: ImageMetadata;
  // Pictures for the collage over the liquid background (CaseCollage)
  images?: ImageMetadata[];
  // The liquid background behind the card (defaults to the shared gradient)
  background?: ImageMetadata;
  imageAlt?: string;
  logo?: ImageMetadata;
}

interface Props {
  item: CaseItem;
  eager?: boolean;
  compact?: boolean;
}

const { item, eager = false, compact = false } = Astro.props;
const parts = [
  { label: 'Challenge', text: hideGaps(item.problem) },
  { label: 'What I did', text: hideGaps(item.whatIDid) },
  { label: 'Result', text: hideGaps(item.result) },
].filter((part) => part.text);
const timeline = hideGaps(item.timeline);
const purpose = hideGaps(item.purpose);
// On hover (and keyboard focus) the border takes the case colour and the card glows in it
// The text part is frosted glass over the liquid background, which runs under the whole card
const glass = 'relative border-border bg-surface/80 backdrop-blur-xl';
const glow =
  'border-border transition-[border-color,box-shadow] duration-300 ease-out hover:border-case-accent hover:shadow-[0_0_56px_-10px_color-mix(in_oklab,var(--color-case-accent-strong)_70%,transparent)] focus-within:border-case-accent focus-within:shadow-[0_0_56px_-10px_color-mix(in_oklab,var(--color-case-accent-strong)_70%,transparent)]';
---

{
  compact ? (
    // The deck version: just the picture, with the company, time, case title and the link under it
    <article
      data-case={item.accent}
      class:list={['group relative flex h-full flex-col overflow-hidden rounded-media border bg-liquid-mid', item.href ? glow : 'border-dashed border-stars']}
    >
      <Image src={item.background ?? gradient} alt="" widths={[640, 1080, 1600]} sizes="(min-width: 1080px) 1100px, 100vw" loading={eager ? 'eager' : 'lazy'} class="absolute inset-0 size-full! max-w-none! object-cover" />
      <div class="relative min-h-0 flex-1">
        {item.images ? (
          <CaseCollage images={item.images} alt={item.imageAlt} eager={eager} bare />
        ) : (
          <div class="grid size-full place-items-center bg-[linear-gradient(140deg,var(--color-liquid-deep),var(--color-liquid-light)_55%,var(--color-liquid-mid))]">
            <span class="eyebrow text-on-liquid">{item.note}</span>
          </div>
        )}
        {/* The glass text area keeps the title link's click area to itself, so the pictures get
            their own link (the title link is the one for keyboards and screen readers) */}
        {item.href && <a href={item.href} class="absolute inset-0 z-40" tabindex="-1" aria-hidden="true" />}
      </div>
      <div class:list={['flex items-end justify-between gap-6 border-t p-6', glass]}>
        <div class="grid min-w-0 gap-2">
          <p class="flex items-center gap-3 text-14 text-text-muted">
            {item.logo && <Image src={item.logo} alt="" widths={[48, 96]} sizes="24px" class="size-6! rounded-pill bg-text object-cover" />}
            <span class="font-display font-heading text-text">{item.client}</span>
            {timeline && <span aria-hidden="true">·</span>}
            {timeline && <span class="tabular-nums">{timeline}</span>}
          </p>
          <h3 class="text-32 leading-tight text-balance">
            {item.href ? (
              <a href={item.href} class="no-underline transition-colors duration-160 ease-out group-hover:text-case-accent-strong after:absolute after:inset-0 after:content-['']">
                {item.title ?? item.client}
              </a>
            ) : (
              (item.title ?? item.client)
            )}
          </h3>
        </div>
        {item.href && (
          <span
            class="inline-flex shrink-0 items-center gap-2 rounded-pill bg-case-accent-strong px-4 py-2 text-14 font-medium text-on-accent transition-transform duration-160 ease-out group-hover:-translate-y-0.5"
            aria-hidden="true"
          >
            Read the case
            <span class="transition-transform duration-160 ease-out group-hover:translate-x-1">→</span>
          </span>
        )}
      </div>
    </article>
  ) : (
    // The full version (phones, tablets, reduced motion): picture, then the case summary
    <article
      data-case={item.accent}
      class:list={['group relative grid overflow-hidden rounded-media border bg-liquid-mid lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)]', item.href ? glow : 'border-dashed border-stars']}
    >
      <Image src={item.background ?? gradient} alt="" widths={[640, 1080, 1600]} sizes="(min-width: 1080px) 1200px, 100vw" loading={eager ? 'eager' : 'lazy'} class="absolute inset-0 size-full! max-w-none! object-cover" />
      <div class="relative aspect-16/10 lg:aspect-auto lg:min-h-[28rem]">
        {item.images ? (
          <CaseCollage images={item.images} alt={item.imageAlt} eager={eager} bare />
        ) : (
          <div class="grid size-full place-items-center bg-[linear-gradient(140deg,var(--color-liquid-deep),var(--color-liquid-light)_55%,var(--color-liquid-mid))]">
            <span class="eyebrow text-on-liquid">{item.note}</span>
          </div>
        )}
        {/* The glass text area keeps the title link's click area to itself, so the pictures get
            their own link (the title link is the one for keyboards and screen readers) */}
        {item.href && <a href={item.href} class="absolute inset-0 z-40" tabindex="-1" aria-hidden="true" />}
      </div>

      <div class:list={['flex min-h-0 flex-col gap-5 border-t p-6 md:p-8 lg:border-t-0 lg:border-l', glass]}>
        <p class="flex items-center gap-3 text-14 text-text-muted">
          {item.logo && <Image src={item.logo} alt="" widths={[48, 96]} sizes="24px" class="size-6! rounded-pill bg-text object-cover" />}
          <span class="font-display font-heading text-text">{item.client}</span>
          {timeline && <span aria-hidden="true">·</span>}
          {timeline && <span class="tabular-nums">{timeline}</span>}
        </p>

        <div>
          <h3 class="text-32 leading-tight text-balance">
            {item.href ? (
              <a href={item.href} class="no-underline transition-colors duration-160 ease-out group-hover:text-case-accent-strong after:absolute after:inset-0 after:content-['']">
                {item.title ?? item.client}
              </a>
            ) : (
              (item.title ?? item.client)
            )}
          </h3>
          {purpose && <p class="mt-3 font-headline text-18 leading-snug font-medium text-text-muted text-balance">{purpose}</p>}
        </div>

        {parts.length > 0 && (
          <dl class="grid gap-4 border-t border-border pt-5">
            {parts.map((part) => (
              <div class="grid gap-1 sm:grid-cols-[8rem_1fr] sm:gap-4">
                <dt class="eyebrow text-14">{part.label}</dt>
                <dd class="text-16 leading-snug">{part.text}</dd>
              </div>
            ))}
          </dl>
        )}

        <div class="mt-auto flex flex-wrap items-center justify-between gap-4 pt-2">
          <RoleBadges roles={item.roles} />
          {item.href && (
            <span class="inline-flex items-center gap-2 text-14 font-medium text-case-accent-strong" aria-hidden="true">
              Read the case
              <span class="transition-transform duration-160 ease-out group-hover:translate-x-1">→</span>
            </span>
          )}
        </div>
      </div>
    </article>
  )
}

---
// The hero's positioning line, one sentence per line. If it contains `phrase` (e.g. "what
// matters") and there are `options`, that phrase becomes a button: each click swaps it for
// the next option ("the experts who use it", …) and cycles back to the phrase.
interface Props {
  text: string;
  phrase?: string;
  options?: string[];
}

const { text, phrase = '', options = [] } = Astro.props;
const sentences = text.split(/(?<=[.!?])\s+/);
const cycle = phrase && options.length ? [phrase, ...options] : [];
---

{
  sentences.map((sentence) => {
    const at = cycle.length ? sentence.indexOf(phrase) : -1;
    if (at < 0) return <span class="block">{sentence}</span>;
    return (
      <span class="block">
        {sentence.slice(0, at)}
        <button
          type="button"
          class="positioning-cycle group/cycle inline cursor-pointer rounded-[4px] text-left"
          data-options={JSON.stringify(cycle)}
          aria-label={`${phrase}. Show another thing I design for`}
        >
          <span
            class="positioning-word inline-block underline decoration-current/45 decoration-dotted decoration-2 underline-offset-[0.18em] transition-[text-decoration-color] duration-160 group-hover/cycle:decoration-current"
            aria-live="polite">{phrase}</span
          >{sentence.slice(at + phrase.length)}<span
            class="ml-2 inline-block align-[0.12em] text-[0.55em] opacity-60 transition-transform duration-300 ease-out group-hover/cycle:rotate-180"
            aria-hidden="true">↻</span
          >
        </button>
      </span>
    );
  })
}

<script>
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll<HTMLButtonElement>('.positioning-cycle').forEach((button) => {
    const options: string[] = JSON.parse(button.dataset.options ?? '[]');
    const word = button.querySelector<HTMLElement>('.positioning-word')!;
    let index = 0;
    button.addEventListener('click', async () => {
      index = (index + 1) % options.length;
      const next = options[index];
      button.setAttribute('aria-label', `${next}. Show another thing I design for`);
      if (reduceMotion.matches) {
        word.textContent = next;
        return;
      }
      await word.animate([{ transform: 'translateY(0)', opacity: 1 }, { transform: 'translateY(-0.4em)', opacity: 0 }], { duration: 160, easing: 'ease-in' }).finished;
      word.textContent = next;
      word.animate([{ transform: 'translateY(0.4em)', opacity: 0 }, { transform: 'translateY(0)', opacity: 1 }], { duration: 220, easing: 'cubic-bezier(0.2, 0.7, 0.2, 1)' });
    });
    // Not clickable once the star transition has covered the hero text
    window.addEventListener('hero-wipe', (e) => {
      const hidden = (e as CustomEvent<number>).detail >= 0.5;
      button.style.pointerEvents = hidden ? 'none' : '';
      button.tabIndex = hidden ? -1 : 0;
    });
  });
</script>

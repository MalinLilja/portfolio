---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CaseBento from '../../components/CaseBento.astro';
import ProcessStepper from '../../components/ProcessStepper.astro';
import LinkButton from '../../components/LinkButton.astro';
import ImageZoom from '../../components/ImageZoom.astro';
import LiquidHero from '../../components/LiquidHero.astro';
import { hideGaps } from '../../lib/brackets';

export async function getStaticPaths() {
  const cases = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return cases.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: cases[(i + 1) % cases.length] },
  }));
}

const { entry, next } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const links = data.links.filter((l) => l.url);
const timeline = hideGaps(data.tldr.timeline);
---

<Base
  title={`${data.client}: ${data.title} | Malin Lilja`}
  description={hideGaps(data.description)}
  ogImage={data.hero}
  ogImageAlt={data.heroAlt}
  ogType="article"
  accent={data.accent}
>
  <article>
    {/* Liquid header in the case's own colours (tokens.css → [data-case]): the client name
        big, then the case title */}
    <LiquidHero labelledby="case-title">
      <a class="inline-flex gap-2 py-2 font-medium text-on-liquid-muted no-underline hover:text-on-liquid" href="/#work"
        ><span aria-hidden="true">←</span> All work</a
      >
      <p class="eyebrow mt-8 text-on-liquid-muted">{data.client}{timeline && ` · ${timeline}`}</p>
      <p
        class:list={[
          'mt-4 font-display leading-[0.95] font-name break-words uppercase',
          data.client.length > 10 ? 'text-hero-long' : 'text-hero',
        ]}
        aria-hidden="true"
      >
        {data.client}
      </p>
      <h1 id="case-title" class="mt-[clamp(32px,6vh,72px)] max-w-[24ch] font-display text-32 leading-[1.15] font-heading text-balance md:text-48">{data.title}</h1>
    </LiquidHero>

    <div class="container-page grid gap-8">
      <CaseBento hero={data.hero} heroAlt={data.heroAlt} roles={data.roles ?? []} purpose={data.purpose} tldr={data.tldr} />
      {data.process && <ProcessStepper steps={data.process} />}
      {
        links.length > 0 && (
          <div class="flex flex-wrap gap-3">
            {links.map((l) => (
              <LinkButton href={l.url}>{l.label}</LinkButton>
            ))}
          </div>
        )
      }
    </div>

    <div class="container-page">
      <div class="prose mx-auto pt-4 [&>h2:first-child]:mt-12">
        <Content />
      </div>
    </div>

    <nav class="container-page mt-24 grid gap-6" aria-label="More work">
      <a
        class="grid gap-2 rounded-card border border-border bg-surface p-8 no-underline transition-colors duration-160 ease-out hover:border-case-accent"
        href={`/work/${next.id}`}
      >
        <span class="eyebrow">Next case</span>
        <span class="font-display text-32 font-heading">{next.data.client}</span>
        <span class="text-text-muted">{next.data.title} <span aria-hidden="true">→</span></span>
      </a>
      <a class="justify-self-start font-medium" href="/#work">Back to all work</a>
    </nav>
  </article>

  <ImageZoom />
</Base>
